# PostgreSQL connection. Store production credentials in the deployment secret manager.
DATABASE_URL=postgresql://dental:local-only@127.0.0.1:5432/dental
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-bytes
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
REGULATED_DATA_KEY=replace-with-base64-encoded-32-byte-key
AUTH_URL=http://localhost:3000
# Optional. AI endpoints fail closed with 503 when this credential is absent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
