// Dental Clinic SaaS Platform - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== User Management & Authentication =====

enum UserRole {
  ADMIN
  RECEPTIONIST
  HYGIENIST
  DENTIST
}

model Clinic {
  id                    String             @id @default(cuid())
  name                  String
  fhirIssuer            String?
  retentionDays         Int                @default(2555)
  createdAt             DateTime           @default(now())
  users                 User[]
  patients              Patient[]
  fhirImports           FhirImport[]
  consents              PatientConsent[]
  clinicalReviews       ClinicalReview[]
  clinicalAuditEvents   ClinicalAuditEvent[]
  securityIncidents     SecurityIncident[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole
  clinicId      String
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  appointments  Appointment[]
  treatments    Treatment[]
  messages      Message[]
  reminders     Reminder[]
  auditLogs     AuditLog[]
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  createdClinicalReviews ClinicalReview[] @relation("ClinicalReviewCreator")
  decidedClinicalReviews ClinicalReview[] @relation("ClinicalReviewDecider")

  @@index([email])
  @@index([role])
  @@index([clinicId])
  @@unique([clinicId, email])
}

// ===== Patient Management =====

model Patient {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  email             String?
  phone             String
  address           String?
  city              String?
  state             String?
  zipCode           String?
  emergencyContact  String?
  emergencyPhone    String?
  medicalHistory    Json?     // Allergies, conditions, medications
  insuranceProvider String?
  insurancePolicyNo String?
  insuranceGroupNo  String?
  notes             String?   @db.Text
  isActive          Boolean   @default(true)
  clinicId          String
  identityMatchKey  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  appointments      Appointment[]
  treatments        Treatment[]
  insuranceClaims   InsuranceClaim[]
  reminders         Reminder[]
  documents         Document[]
  clinic            Clinic    @relation(fields: [clinicId], references: [id])
  fhirImports       FhirImport[]
  consents          PatientConsent[]
  clinicalReviews   ClinicalReview[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([clinicId])
  @@unique([clinicId, identityMatchKey])
}

// ===== Appointment Scheduling =====

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CHECKUP
  CLEANING
  CONSULTATION
  FILLING
  ROOT_CANAL
  EXTRACTION
  CROWN
  BRIDGE
  IMPLANT
  ORTHODONTICS
  EMERGENCY
  FOLLOW_UP
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  dentistId   String?
  type        AppointmentType
  status      AppointmentStatus @default(SCHEDULED)
  startTime   DateTime
  endTime     DateTime
  reason      String?           @db.Text
  notes       String?           @db.Text
  roomNumber  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentist     User?             @relation(fields: [dentistId], references: [id])
  treatments  Treatment[]

  @@index([patientId])
  @@index([dentistId])
  @@index([startTime])
  @@index([status])
}

// ===== Treatment Management =====

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Treatment {
  id              String          @id @default(cuid())
  patientId       String
  appointmentId   String?
  dentistId       String
  treatmentCode   String          // CDT code
  treatmentName   String
  description     String?         @db.Text
  toothNumber     String?
  status          TreatmentStatus @default(PLANNED)
  estimatedCost   Decimal         @db.Decimal(10, 2)
  actualCost      Decimal?        @db.Decimal(10, 2)
  startDate       DateTime?
  completionDate  DateTime?
  notes           String?         @db.Text
  checklist       Json?           // Treatment steps checklist
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  dentist         User            @relation(fields: [dentistId], references: [id])
  insuranceClaims InsuranceClaim[]

  @@index([patientId])
  @@index([dentistId])
  @@index([status])
  @@index([treatmentCode])
}

// ===== Insurance & Billing =====

enum ClaimStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  PAID
}

model InsuranceClaim {
  id                String      @id @default(cuid())
  patientId         String
  treatmentId       String?
  claimNumber       String      @unique
  insuranceProvider String
  policyNumber      String
  status            ClaimStatus @default(DRAFT)
  submittedDate     DateTime?
  approvedDate      DateTime?
  deniedDate        DateTime?
  claimedAmount     Decimal     @db.Decimal(10, 2)
  approvedAmount    Decimal?    @db.Decimal(10, 2)
  paidAmount        Decimal?    @db.Decimal(10, 2)
  denialReason      String?     @db.Text
  notes             String?     @db.Text
  claimData         Json?       // AI-processed claim data
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment         Treatment?  @relation(fields: [treatmentId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([claimNumber])
}

// ===== Communication & Reminders =====

enum ReminderType {
  APPOINTMENT
  FOLLOW_UP
  MEDICATION
  PAYMENT
  INSURANCE
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Reminder {
  id          String         @id @default(cuid())
  patientId   String
  userId      String?
  type        ReminderType
  status      ReminderStatus @default(PENDING)
  title       String
  message     String         @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  method      String         // SMS, EMAIL, PUSH
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])

  @@index([patientId])
  @@index([scheduledAt])
  @@index([status])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  recipientId String?
  subject    String?
  body       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  sender     User     @relation(fields: [senderId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// ===== Document Management =====

enum DocumentType {
  XRAY
  CONSENT_FORM
  INSURANCE_CARD
  MEDICAL_HISTORY
  TREATMENT_PLAN
  PRESCRIPTION
  LAB_REPORT
  OTHER
}

model Document {
  id          String       @id @default(cuid())
  patientId   String
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  description String?
  uploadedAt  DateTime     @default(now())

  // Relations
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([type])
}

// ===== Audit & Analytics =====

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ClinicalReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum ClinicalRiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum SecurityIncidentStatus {
  OPEN
  CONTAINED
  CLOSED
}

model PatientConsent {
  id             String        @id @default(cuid())
  clinicId       String
  patientId      String
  scope          String
  source         String
  status         ConsentStatus @default(ACTIVE)
  effectiveAt    DateTime
  expiresAt      DateTime?
  revokedAt      DateTime?
  recordedById   String
  provenanceJson Json
  createdAt      DateTime      @default(now())
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, status])
}

model FhirImport {
  id                String   @id @default(cuid())
  clinicId          String
  patientId         String
  consentId         String
  resourceType      String
  sourceSystem      String
  sourceResourceId  String
  sourceVersion     String?
  payloadCiphertext String   @db.Text
  payloadDigest     String
  importedById      String
  importedAt        DateTime @default(now())
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, sourceSystem, sourceResourceId, payloadDigest])
  @@index([clinicId, patientId, importedAt])
}

model ClinicalReview {
  id                       String               @id @default(cuid())
  clinicId                 String
  patientId                String
  fhirImportId             String?
  status                   ClinicalReviewStatus @default(PENDING_REVIEW)
  riskLevel                ClinicalRiskLevel
  recommendationCiphertext String               @db.Text
  evidenceJson             Json
  contraindicationsJson    Json
  missingDataJson          Json
  provenanceJson           Json
  escalationReason         String?              @db.Text
  createdById              String
  decidedById              String?
  decidedAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  clinic                   Clinic               @relation(fields: [clinicId], references: [id])
  patient                  Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy                User                 @relation("ClinicalReviewCreator", fields: [createdById], references: [id])
  decidedBy                User?                @relation("ClinicalReviewDecider", fields: [decidedById], references: [id])

  @@index([clinicId, status, riskLevel])
  @@index([clinicId, patientId, createdAt])
}

model ClinicalAuditEvent {
  id            String   @id @default(cuid())
  clinicId      String
  actorId       String
  action        String
  entityType    String
  entityId      String
  metadataJson  Json
  previousHash  String?
  eventHash     String
  retentionUntil DateTime
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, eventHash])
  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
}

model SecurityIncident {
  id               String                 @id @default(cuid())
  clinicId         String
  severity         ClinicalRiskLevel
  status           SecurityIncidentStatus @default(OPEN)
  summary          String                 @db.Text
  affectedDataJson Json
  containedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime               @default(now())
  clinic           Clinic                 @relation(fields: [clinicId], references: [id])

  @@index([clinicId, status, severity])
}
